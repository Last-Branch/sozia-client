{
  "name": "sozia-client",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/expo.js start",
    "android": "node scripts/expo.js start --android",
    "ios": "node scripts/expo.js start --ios",
    "web": "node scripts/expo.js start --web",
    "test": "jest",
    "lint": "eslint sozia --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/__tests__/**/*.test.ts"
        ],
        "transform": {
          "^.+\\.ts$": [
            "ts-jest",
            {
              "tsconfig": "./tsconfig.test.json"
            }
          ]
        },
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/sozia/client/$1",
          "^@common/(.*)$": "<rootDir>/sozia/common/$1"
        }
      }
    ]
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.34",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.33",
    "expo-audio": "~1.1.1",
    "expo-camera": "~17.0.10",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.577.0",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-web": "^0.21.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
