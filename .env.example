# Firebase project config — Firebase Console > Project Settings > Your apps > Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth client IDs — Google Cloud Console > Credentials
# Android: OAuth client type "Android", package com.lastbranch.soziaclient
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# iOS: OAuth client type "iOS", bundle ID com.lastbranch.soziaclient
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Web: OAuth client type "Web application", authorized redirect URI = https://auth.expo.io/@last-branch/sozia-client
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Backend WebSocket URL
EXPO_PUBLIC_SERVER_URL=

# Backend API key — sent in session_init message
EXPO_PUBLIC_API_KEY=lastbranchapiwtf
